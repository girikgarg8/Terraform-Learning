**/requests_in_zip.zip
**/lambda_bundle/
**/layer_build/
**/requests_layer.zip
**/code_only.zip
**/custom_utils_layer.zip
**/versioned.zip
**/versioned_v1_lambda.zip
**/versioned_v2_lambda.zip
**/versioned_lambda.zip
**/public_no_nat.zip
**/private_with_nat.zip
**/reserved_concurrency.zip
**/provisioned_concurrency.zip
**/lambda_destination.zip
**/lambda_rds_connectivity.zip

# macOS
.DS_Store
.AppleDouble
.LSOverride

